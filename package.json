{
  "name": "spre",
  "version": "0.1.0",
  "private": true,
  "description": "Scratchpiler Runtime Environment: a deterministic harness around scratch-vm with a virtual clock, seeded RNG streams, scriptable input and full snapshots",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./node": "./src/node.js",
    "./diff": "./src/diff.js",
    "./profile": "./src/profile.js",
    "./replay": "./src/replay.js"
  },
  "bin": {
    "spre": "bin/spre.js"
  },
  "scripts": {
    "test": "node --test tests/*.test.js",
    "build": "node build.js",
    "build:dev": "node build.js --dev",
    "watch": "node --watch-path=src --watch-path=build.js build.js --dev"
  },
  "license": "AGPL-3.0-only",
  "dependencies": {
    "@resvg/resvg-wasm": "^2.6.2",
    "fast-png": "^8.0.0",
    "hull.js": "^0.2.10",
    "jpeg-js": "^0.4.4",
    "scratch-vm": "^5.0.300",
    "twgl.js": "^4.24.0",
    "scratch-render-fonts": "1.0.252"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
